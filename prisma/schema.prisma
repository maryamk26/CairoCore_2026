generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum PlaceType {
  place_to_visit
  cafe
  restaurant
}

enum PlaceCategory {
  museum
  historical_site
  pyramids
  mosque
  church
  palace
  citadel
  park
  mall
  amusement_park
  activity
  famous_street
  market
  viewpoint
  romantic_spot
  adventure
  cafe
  restaurant
}

enum PlaceVibe {
  ancient
  historical
  traditional
  modern
  nature
  outdoors
  romantic
  photography
  adventure
  shopping
}

model User {
  id        String   @id
  email     String   @unique
  name      String?
  username  String?
  createdAt DateTime @default(now())

  places     Place[]
  folders    Folder[]
  following  Follow[]        @relation("Following")
  followers  Follow[]        @relation("Followers")
  feedbacks  PlaceFeedback[]

  @@map("users")
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedPlaces SavedPlace[]

  @@map("folders")
}

model SavedPlace {
  id        String   @id @default(uuid())
  folderId  String
  placeId   String
  createdAt DateTime @default(now())

  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  place  Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([folderId, placeId])
  @@map("saved_places")
}

model Place {
  id              String        @id @default(uuid())
  type            PlaceType     @default(place_to_visit)
  name            String
  description     String?       @db.Text
  category        PlaceCategory?
  latitude        Float
  longitude       Float
  address         String?
  city            String?
  openingHours    String?       // JSON: per-day { "monday": { "start": "9:00 AM", "end": "5:00 PM" } | "closed" }
  entranceFee     Float?
  cameraFee       Float?
  vibe            PlaceVibe?
  vibes           String[]     @default([])  // multiple vibes
  tags            String[]      @default([])
  bestVisitTime   String?
  images          String[]      @default([])
  kidsFriendly    Boolean?
  elderlyFriendly Boolean?
  petsFriendly    Boolean?
  createdBy       String?
  createdAt       DateTime      @default(now())

  user      User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  savedIn   SavedPlace[]
  feedbacks PlaceFeedback[]

  @@map("places")
}

model PlaceFeedback {
  id        String   @id @default(uuid())
  userId    String
  placeId   String
  rating    Int?
  content   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([placeId, createdAt])
  @@index([userId, createdAt])
  @@map("place_feedback")
}
