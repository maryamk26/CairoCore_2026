generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum PlaceType {
  place_to_visit
  cafe
  restaurant
}

enum PlaceCategory {
  museum
  historical_site
  pyramids
  mosque
  church
  palace
  citadel
  park
  mall
  amusement_park
  activity
  famous_street
  market
  viewpoint
  romantic_spot
  adventure
  cafe
  restaurant
}

enum PlaceVibe {
  ancient
  historical
  traditional
  modern
  nature
  outdoors
  romantic
  photography
  adventure
  shopping
}

enum UserRole {
  USER
  ADMIN
}

enum ModerationTargetType {
  PLACE
  FEEDBACK
  USER
}

enum ModerationActionType {
  SOFT_DELETE_CONTENT
  BAN_USER
  AUTO_BAN_AT_STRIKE_LIMIT
  RESTORE_CONTENT
}

model User {
  id        String   @id
  email     String   @unique
  name      String?
  username  String?
  role      UserRole @default(USER)
  isBanned  Boolean  @default(false) @map("is_banned")
  bannedAt  DateTime? @map("banned_at")
  banReason String?  @map("ban_reason") @db.Text
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now())

  places       Place[]
  folders      Folder[]
  savedRoutes  SavedRoute[]
  following    Follow[]        @relation("Following")
  followers    Follow[]        @relation("Followers")
  feedbacks    PlaceFeedback[]
  moderationActions ModerationAction[] @relation("ModerationAdmin")
  moderatedContent  ModerationAction[] @relation("ModerationOwner")

  @@index([createdAt])
  @@map("users")
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedPlaces SavedPlace[]

  @@map("folders")
}

model SavedPlace {
  id        String   @id @default(uuid())
  folderId  String
  placeId   String
  createdAt DateTime @default(now())

  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  place  Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([folderId, placeId])
  @@map("saved_places")
}

model Place {
  id              String        @id @default(uuid())
  type            PlaceType     @default(place_to_visit)
  name            String
  description     String?       @db.Text
  category        PlaceCategory?
  latitude        Float
  longitude       Float
  address         String?
  city            String?
  openingHours    String?       // JSON: per-day { "monday": { "start": "9:00 AM", "end": "5:00 PM" } | "closed" }
  entranceFee     Float?
  cameraFee       Float?
  vibe            PlaceVibe?
  vibes           String[]     @default([])  // multiple vibes
  tags            String[]      @default([])
  bestVisitTime   String?
  images          String[]      @default([])
  kidsFriendly    Boolean?
  elderlyFriendly Boolean?
  petsFriendly    Boolean?
  createdBy       String?
  deletedAt       DateTime?     @map("deleted_at")
  deletedByAdminId String?      @map("deleted_by_admin_id")
  deleteReason    String?       @map("delete_reason") @db.Text
  createdAt       DateTime      @default(now())

  user             User?             @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  savedIn          SavedPlace[]
  savedRouteItems  SavedRoutePlace[]
  feedbacks        PlaceFeedback[]
  embedding        PlaceEmbedding?

  @@index([createdAt])
  @@map("places")
}

/// Vector row for semantic search (pgvector). Dimension must match `AI_PLANNER_EMBEDDING_DIMENSIONS` / LM Studio embedding model.
model PlaceEmbedding {
  placeId    String                      @id @map("place_id")
  place      Place                       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  embedding  Unsupported("vector(768)")
  sourceText String                      @map("source_text") @db.Text
  updatedAt  DateTime                    @default(now()) @updatedAt @map("updated_at")

  @@map("place_embeddings")
}

model SavedRoute {
  id            String            @id @default(uuid())
  userId        String
  name          String
  transportMode String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  places SavedRoutePlace[]

  @@index([userId, createdAt])
  @@map("saved_routes")
}

model SavedRoutePlace {
  id           String     @id @default(uuid())
  savedRouteId String
  placeId      String
  position     Int

  savedRoute SavedRoute @relation(fields: [savedRouteId], references: [id], onDelete: Cascade)
  place      Place      @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([savedRouteId, position])
  @@index([savedRouteId, position])
  @@map("saved_route_places")
}

model PlaceFeedback {
  id        String   @id @default(uuid())
  userId    String
  placeId   String
  rating    Int?
  content   String?  @db.Text
  deletedAt DateTime? @map("deleted_at")
  deletedByAdminId String? @map("deleted_by_admin_id")
  deleteReason String? @map("delete_reason") @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([placeId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("place_feedback")
}

model ModerationAction {
  id          String               @id @default(uuid())
  adminId     String               @map("admin_id")
  targetType  ModerationTargetType @map("target_type")
  targetId    String               @map("target_id")
  ownerUserId String?              @map("owner_user_id")
  actionType  ModerationActionType @map("action_type")
  reason      String               @db.Text
  snapshot    Json?
  createdAt   DateTime             @default(now()) @map("created_at")

  admin User  @relation("ModerationAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  owner User? @relation("ModerationOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, createdAt])
  @@index([targetType, createdAt])
  @@map("moderation_actions")
}
