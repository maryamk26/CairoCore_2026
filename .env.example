SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

OPENROUTESERVICE_API_KEY=

DATABASE_URL=
SHADOW_DATABASE_URL=

# --- Planner AI (LM Studio local) ---
# LM Studio: start app server + load embedding model before sync/embed.
AI_PLANNER_ENABLED=false
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_EMBEDDING_MODEL=text-embedding-embeddinggemma-300m-qat
# Chat model id for OpenAI-compatible POST .../v1/chat/completions (not /api/v1/chat). Example:
# LM_STUDIO_CHAT_MODEL=qwen/qwen3-1.7b
LM_STUDIO_CHAT_MODEL=
# After create/PATCH place, refresh pgvector row (only when AI_PLANNER_ENABLED=true). Set false to batch-only.
AI_PLANNER_AUTO_EMBED_ON_WRITE=true
# Embeddings HTTP timeout (ms)
AI_PLANNER_TIMEOUT_MS=8000
# Chat rerank can be slow on CPU — raise if you see AbortError / rerank_skipped
AI_PLANNER_CHAT_TIMEOUT_MS=120000
# Qwen3: rerank appends /no_think to the user message so the model skips long “thinking” (LM Studio logs).
AI_PLANNER_RULE_TOP_K=40
AI_PLANNER_VECTOR_TOP_K=40
# Hybrid-ranked head for café/restaurant stops; remainder appended A–Z
AI_PLANNER_STOPS_HEAD_LIMIT=48
# pgvector column size must match embedding model output (768 for EmbeddingGemma above)
AI_PLANNER_EMBEDDING_DIMENSIONS=768

# POST /api/places/embeddings/sync — required outside development
PLACES_EMBED_SECRET=
# Optional for `npm run embed:places`: EMBED_LIMIT=50 EMBED_SKIP_EXISTING=1 EMBED_PLACE_IDS=id1,id2
