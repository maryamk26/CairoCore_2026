@startuml planner_api_client_osrm
title CairoCore Planner — API + browser + OSRM

skinparam sequenceMessageAlign center
skinparam responseMessageAlign center
skinparam wrapWidth 180

actor User
participant "PlannerPage\napp/planner/page.tsx" as Page
participant "Next.js\nPOST /api/planner/recommend" as RecAPI
participant "Next.js\nGET /api/planner/stops" as StopsAPI
participant "Prisma\nPostgreSQL" as DB
participant "RouteBuilder +\nuseRouteBuilderState" as RB
participant "Browser\nnavigator.geolocation" as Geo
participant "POST /api/planner/optimize" as OptAPI
participant "optimizeRouteFromLocation\n(server)" as Algo
participant "fetchOsrmRoute\nutils/planner/osrm.ts" as OsrmClient
participant "OSRM\nrouter.project-osrm.org" as OSRM

User -> Page: Complete survey (preferences)
Page -> RecAPI: POST { preferences }
RecAPI -> DB: place.findMany + scoring
DB --> RecAPI: candidate places
RecAPI -> RecAPI: getTopRecommendations(...)
RecAPI --> Page: { recommendations }
Page -> Page: setRecommendations, stage → selection

User -> Page: Select places, continue
alt coffee_shop or restaurant stop
  Page -> StopsAPI: GET ?type=coffee_shop | restaurant
  StopsAPI -> DB: place.findMany by type
  DB --> StopsAPI: rows
  StopsAPI --> Page: { recommendations }
  Page -> Page: stage → stop, then route
else no stop step
  Page -> Page: stage → route
end

User -> Page: Open route builder
Page -> RB: Mount with places (+ optional route stop)

RB -> Geo: getCurrentPosition()
Geo --> RB: lat, lng

RB -> OptAPI: POST { userLocation, stops }
OptAPI -> Algo: optimizeRouteFromLocation(...)
Algo --> OptAPI: order, distances
OptAPI --> RB: { order }

User -> RB: Choose transport mode
RB -> OsrmClient: fetchOsrmRoute(userLoc, stops, mode)
OsrmClient -> OSRM: GET /route/v1/{profile}/coords...
OSRM --> OsrmClient: routes (distance, duration, geometry)
OsrmClient --> RB: distanceKm, durationMinutes
RB -> RB: tripStats (travel + visit time)

note bottom of Page
  Deep links: ?placeIds=… loads /api/places/:id;\n?savedRouteId=… loads /api/profile/routes/:id.\nThose paths skip survey/recommend but still use\nRouteBuilder + OSRM on the route stage.
end note

@enduml
